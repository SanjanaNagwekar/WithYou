CARTESIA_API_KEY=
CARTESIA_MODEL_ID=sonic-3.6
# Local automated demos only. Never enable the mock provider in production.
WITHYOU_VOICE_PROVIDER=cartesia
WITHYOU_ALLOW_MOCK_PROVIDER=false

# Required in production. Generate a high-entropy value with at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Optional locally. Configure both values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
