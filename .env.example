CARTESIA_API_KEY=
CARTESIA_MODEL_ID=sonic-3.6
# Local automated demos only. Never enable the mock provider in production.
WITHYOU_VOICE_PROVIDER=cartesia
WITHYOU_ALLOW_MOCK_PROVIDER=false

# Google Cloud Translation Advanced (v3). Store the complete service-account JSON
# as one secret value. Never expose it with a NEXT_PUBLIC_ prefix.
GOOGLE_TRANSLATE_SERVICE_ACCOUNT_JSON=
WITHYOU_TRANSLATION_PROVIDER=google
# Local automated demos only. Never enable mock translation in production.
WITHYOU_ALLOW_MOCK_TRANSLATION=false

# Required in production. Generate a high-entropy value with at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Optional locally. Configure both values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional until email verification and password recovery are enabled.
# Use a verified sender address, for example: accounts@your-domain.com
RESEND_API_KEY=
AUTH_EMAIL_FROM=
